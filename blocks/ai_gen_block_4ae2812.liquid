{% doc %}
  @prompt
    Divider line block, Section background + right and left spacing, Remove desktop width option, Opacity
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: {{ block.settings.spacing_top }}px {{ block.settings.spacing_right }}px {{ block.settings.spacing_bottom }}px {{ block.settings.spacing_left }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-divider-{{ ai_gen_id }}__line {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    opacity: {{ block.settings.line_opacity | divided_by: 100.0 }};
    border-radius: {{ block.settings.line_thickness }}px;
  }
{% endstyle %}

<div class="ai-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-divider-{{ ai_gen_id }}__line" role="presentation"></div>
</div>

{% schema %}
{
  "name": "Divider line",
  "settings": [
    {"type":"header","content":"Divider"},
    {"type":"color","id":"background_color","label":"Background","default":"#f6f5f3"},
    {"type":"color","id":"line_color","label":"Line","default":"#e8e8e1"},
    {"type":"range","id":"line_thickness","label":"Thickness","min":1,"max":10,"step":1,"unit":"px","default":1},
    {"type":"range","id":"line_opacity","label":"Opacity","min":10,"max":100,"step":10,"unit":"%","default":100},
    {"type":"header","content":"Spacing"},
    {"type":"range","id":"spacing_top","label":"Top","min":0,"max":100,"step":5,"unit":"px","default":20},
    {"type":"range","id":"spacing_right","label":"Right","min":0,"max":100,"step":5,"unit":"px","default":0},
    {"type":"range","id":"spacing_bottom","label":"Bottom","min":0,"max":100,"step":5,"unit":"px","default":20},
    {"type":"range","id":"spacing_left","label":"Left","min":0,"max":100,"step":5,"unit":"px","default":0}
  ],
  "presets":[{"name":"Divider line"}],
  "tag":null,
  "class":"divider-line-block"
}
{% endschema %}