  {% comment %} App-page redirects added by Smartsy on 16-09-2026 {% endcomment %}

<script>
(()=>{
  const p=location.pathname.replace(/\/$/,'');
  const r={
    '/a/faq':'/pages/frequently-asked-questions',
    '/a/review/all':'/pages/reviews'
  };
  for(const [from,to] of Object.entries(r))
    if(p.endsWith(from)){
      location.replace(p.slice(0,-from.length)+to+location.search+location.hash);
      break;
    }
})();
</script>

