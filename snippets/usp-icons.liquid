{%- comment -%}
  USP icons block: up to 6 items, each an icon and a short text (translatable
  with the theme's translations / Translate & Adapt). Icons are inline SVGs
  that take the text colour, or the colour picked in the block.
  Desktop: one row. Narrow column or phone: 3 per row.
{%- endcomment -%}
{%- liquid
  assign usp_count = 0
  for i in (1..6)
    assign text_key = 'text_' | append: i
    if block.settings[text_key] != blank
      assign usp_count = usp_count | plus: 1
    endif
  endfor
-%}
{%- if usp_count > 0 -%}
<style>
  .jalg-usp {
    container-type: inline-size;
    padding: 18px 0;
    border-top: 1px solid #e8e8e1;
    border-bottom: 1px solid #e8e8e1;
  }
  .jalg-usp__list {
    display: grid;
    grid-template-columns: repeat(var(--usp-count), minmax(0, 1fr));
    gap: 16px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jalg-usp__item { margin: 0; text-align: center; }
  .jalg-usp__item a { display: block; color: inherit; text-decoration: none; }
  .jalg-usp__icon {
    display: block;
    width: 40px;
    height: 40px;
    margin: 0 auto 8px;
    color: var(--usp-icon-color, currentColor);
  }
  .jalg-usp__icon svg, .jalg-usp__icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .jalg-usp__icon text { font-family: var(--typeBasePrimary), var(--typeBaseFallback); }
  .jalg-usp__text {
    display: block;
    font-size: 13px;
    line-height: 1.3;
    color: #444;
  }
  .jalg-usp__item a:hover .jalg-usp__text { text-decoration: underline; text-underline-offset: 3px; }
  /* narrow column (phones, small tablets): 3 per row */
  @container (max-width: 480px) {
    .jalg-usp__list { grid-template-columns: repeat(min(3, var(--usp-count)), minmax(0, 1fr)); gap: 16px 6px; }
    .jalg-usp__icon { width: 32px; height: 32px; }
    .jalg-usp__text { font-size: 12px; }
  }
</style>
<div class="jalg-usp"{% if block.settings.icon_color != blank %} style="--usp-icon-color: {{ block.settings.icon_color }};"{% endif %}>
  <ul class="jalg-usp__list" style="--usp-count: {{ usp_count }};">
    {%- for i in (1..6) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: i
        assign image_key = 'image_' | append: i
        assign text_key = 'text_' | append: i
        assign link_key = 'link_' | append: i
        assign usp_text = block.settings[text_key]
        assign usp_link = block.settings[link_key]
      -%}
      {%- if usp_text != blank -%}
        <li class="jalg-usp__item">
          {%- if usp_link != blank -%}<a href="{{ usp_link }}">{%- endif -%}
          <span class="jalg-usp__icon" aria-hidden="true">
            {%- if block.settings[image_key] != blank -%}
              {{ block.settings[image_key] | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                {%- case block.settings[icon_key] -%}
      {%- when 'fast-dispatch' -%}<path d="M4 12a8 8 0 0 1 13.66-5.66L19.5 8.2"/><path d="M19.5 3.7v4.5H15"/><path d="M20 12a8 8 0 0 1-13.66 5.66L4.5 15.8"/><path d="M4.5 20.3v-4.5H9"/>
      {%- when 'warranty' -%}<circle cx="12" cy="12" r="9"/><path d="M8.2 12.2l2.6 2.7 5-5.4"/>
      {%- when 'easy-assembly' -%}<path d="M9.3 21.5v-1.9c0-.6-.2-1.1-.6-1.5l-2.9-3a1.3 1.3 0 0 1 1.8-1.8l1.7 1.5V8.2a1.25 1.25 0 0 1 2.5 0v4.6"/><path d="M11.8 12.3v-1.4a1.2 1.2 0 0 1 2.4 0v1.6"/><path d="M14.2 12.1v-.9a1.2 1.2 0 0 1 2.4 0v1.3"/><path d="M16.6 12.3a1.2 1.2 0 0 1 2.4 0v3.6c0 3-2 5.6-5 5.6"/><path d="M10.55 2.5v2M7.3 3.9l1.2 1.3M13.8 3.9l-1.2 1.3"/>
      {%- when 'fits-most-tvs' -%}<rect x="2.5" y="4" width="19" height="12.5" rx=".6"/><path d="M12 16.5V20M8 20.5h8"/><path d="M9.2 10.1l2 2 3.8-3.9"/>
      {%- when 'vesa' -%}<circle cx="4" cy="5.5" r=".9"/><circle cx="20" cy="5.5" r=".9"/><circle cx="4" cy="18.5" r=".9"/><circle cx="20" cy="18.5" r=".9"/><text x="12" y="14.3" text-anchor="middle" fill="currentColor" stroke="none" font-size="6.6" letter-spacing=".4">VESA</text>
      {%- when 'scandinavian-design' -%}<rect x="2.5" y="5.5" width="19" height="13" rx=".4"/><path d="M8.5 5.5v13M2.5 12h19"/>
      {%- when 'delivery' -%}<path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4.2l3.3 3.6v2.9h-7.5"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17.3" cy="17.5" r="1.7"/>
      {%- when 'sustainable' -%}<path d="M5.5 18.5c-1.8-6 2.5-12.5 13-13-.2 9.5-6.3 14.7-13 13Z"/><path d="M5 19.5l9.5-9.5"/>
                {%- endcase -%}
              </svg>
            {%- endif -%}
          </span>
          <span class="jalg-usp__text">{{ usp_text }}</span>
          {%- if usp_link != blank -%}</a>{%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
