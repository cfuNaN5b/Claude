{%- comment -%}
  JALG Trust line (product block): up to 3 short points with small icons,
  meant to sit directly under the Buy buttons. One centred line on desktop;
  in a narrow column the points sit side by side with the icon above the text.
{%- endcomment -%}
<style>
  .jalg-trust { container-type: inline-size; }
  .jalg-trust__list {
    display: flex;
    justify-content: center;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jalg-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
  }
  .jalg-trust__icon {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    color: var(--jt-accent, #3d5640);
  }
  .jalg-trust__icon svg { display: block; width: 100%; height: 100%; stroke-width: var(--jt-stroke, 1.8); }
  @container (max-width: 459px) {
    .jalg-trust__list { display: grid; grid-template-columns: repeat(var(--jt-count), minmax(0, 1fr)); gap: 0 8px; }
    .jalg-trust__item { flex-direction: column; gap: 4px; font-size: 12px; text-align: center; }
  }
</style>
{%- liquid
  assign trust_count = 0
  for i in (1..3)
    assign text_key = 'text_' | append: i
    if block.settings[text_key] != blank
      assign trust_count = trust_count | plus: 1
    endif
  endfor
-%}
{%- if trust_count > 0 -%}
<div class="jalg-trust" style="--jt-count: {{ trust_count }}; --jt-accent: {{ block.settings.accent | default: '#3d5640' }}; --jt-stroke: {{ block.settings.stroke | divided_by: 10.0 }};">
  <ul class="jalg-trust__list" role="list">
    {%- for i in (1..3) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: i
        assign text_key = 'text_' | append: i
      -%}
      {%- if block.settings[text_key] != blank -%}
        <li class="jalg-trust__item">
          <span class="jalg-trust__icon">{%- render 'jalg-feature-icon', icon: block.settings[icon_key] -%}</span>
          <span>{{ block.settings[text_key] | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
