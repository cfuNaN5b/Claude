{%- comment -%}
  JALG Feature list (product block): up to 6 features, each a line icon, a
  title and an optional line below. Two columns in the product column, one
  column when it gets narrow. Hidden in the Quick Add window to keep it short.
  Texts can be translated in Translate & Adapt, and each field can be connected
  to a product metafield (dynamic source) for product-specific figures.
{%- endcomment -%}
{%- liquid
  assign feature_count = 0
  for i in (1..6)
    assign title_key = 'title_' | append: i
    if block.settings[title_key] != blank
      assign feature_count = feature_count | plus: 1
    endif
  endfor
-%}
{%- if feature_count > 0 -%}
<style>
  .jalg-features {
    container-type: inline-size;
    --jf-accent: #3d5640;
    --jf-muted: color-mix(in srgb, var(--colorTextBody, #000) 73%, var(--colorBody, #f6f5f3));
  }
  .jalg-features__label {
    margin: 0 0 4px;
    color: var(--jf-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
  }
  .jalg-features__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jalg-features__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid var(--colorBorder, #e8e8e1);
  }
  .jalg-features__icon {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    color: var(--jf-accent);
  }
  .jalg-features__icon svg { display: block; width: 100%; height: 100%; stroke-width: var(--jf-stroke, 1.5); }
  .jalg-features__text { min-width: 0; }
  .jalg-features__title { display: block; font-size: 15px; font-weight: 500; line-height: 1.45; }
  .jalg-features__line { display: block; color: var(--jf-muted); font-size: 13px; line-height: 1.45; }
  @container (max-width: 299px) {
    .jalg-features__list { grid-template-columns: 1fr; }
  }
  .modal--quick-shop .jalg-features { display: none; }
</style>
<div class="jalg-features" style="--jf-accent: {{ block.settings.accent | default: '#3d5640' }}; --jf-stroke: {{ block.settings.stroke | divided_by: 10.0 }};">
  {%- if block.settings.label != blank -%}
    <p class="subheading jalg-features__label">{{ block.settings.label | escape }}</p>
  {%- endif -%}
  <ul class="jalg-features__list" role="list">
    {%- for i in (1..6) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: i
        assign title_key = 'title_' | append: i
        assign line_key = 'line_' | append: i
      -%}
      {%- if block.settings[title_key] != blank -%}
        <li class="jalg-features__item">
          <span class="jalg-features__icon">{%- render 'jalg-feature-icon', icon: block.settings[icon_key] -%}</span>
          <span class="jalg-features__text">
            <span class="jalg-features__title">{{ block.settings[title_key] | escape }}</span>
            {%- if block.settings[line_key] != blank -%}
              <span class="jalg-features__line">{{ block.settings[line_key] | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
