{%- comment -%}
  "This item" uses the selected variant (not product.price, which is the lowest
  price of all variants). theme.js updates it when another variant is picked.
  Extra products also use the price of the variant that gets added to the cart.
  Rendered by the "Bought together" product block. Optional: `title`,
  `visible_count` / `visible_count_mobile` (products shown before "Show more",
  default 4), `show_thumbs_mobile` (small images on phones, default on) and
  `spacing_top` / `spacing_bottom` (px, default 20).
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign main_image = current_variant.featured_image | default: product.featured_image -%}
{%- liquid
  assign freq_limit = visible_count | default: 4
  assign freq_limit_m = visible_count_mobile | default: freq_limit
  assign freq_thumbs = true
  if show_thumbs_mobile == false
    assign freq_thumbs = false
  endif
  assign freq_space_top = spacing_top | default: 20
  assign freq_space_bottom = spacing_bottom | default: 20
  if spacing_top == 0
    assign freq_space_top = 0
  endif
  if spacing_bottom == 0
    assign freq_space_bottom = 0
  endif
-%}
{% if product.metafields.custom.extra_products != blank and current_variant.available %}
    {%- comment -%}
      Each row: checkbox, (thumbnail on phones), name, price on the right.
      Only the first few extra products show (separate numbers for desktop and
      mobile, block settings); "Show N more" reveals the rest.
      Hovering a row shows the image in a popup to the left of the list (only
      on devices with a mouse). `.freq:not(#jalg)` outranks older template
      Custom CSS for .freq__item, so these rules apply everywhere.
    {%- endcomment -%}
    <style>
      .freq:not(#jalg) .freq__title { margin-top: 0; }
      .freq:not(#jalg) .freq__list { margin: 0; }
      .freq:not(#jalg) .freq__item {
        position: relative;
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr) auto;
        align-items: center;
        column-gap: 12px;
        margin: 0;
        padding: 6px 0;
        border-bottom: 1px solid var(--colorBorder, #e8e8e1);
      }
      .freq__more-m, .freq__more-less { display: none; }
      .freq--open .freq__more-d { display: none; }
      .freq--open .freq__more-less { display: inline; }
      @media only screen and (min-width: 590px) {
        .freq:not(#jalg):not(.freq--open) .freq__item--more-d { display: none; }
        .freq:not(#jalg) .freq__more.freq__more--none-d { display: none; }
      }
      .freq:not(#jalg) .freq__more {
        display: inline-block;
        margin: 8px 0 0;
        padding: 0;
        border: 0;
        background: none;
        color: #3d5640;
        font-size: 14px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }
      .freq:not(#jalg) .freq__item:last-child { border-bottom: 0; }
      .freq:not(#jalg) .freq__check {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: #3d5640;
      }
      .freq:not(#jalg) .freq__thumb { display: none; }
      .freq:not(#jalg) .freq__name {
        display: block;
        min-width: 0;
        /* "This item" is a <label>: drop the theme's label margin and heading font */
        margin: 0;
        font-family: inherit;
        font-weight: inherit;
        letter-spacing: inherit;
        text-transform: none;
        color: inherit;
        font-size: 15px;
        line-height: 1.35;
        text-decoration: none;
      }
      .freq:not(#jalg) a.freq__name,
      .freq:not(#jalg) a.freq__name:hover { text-decoration: none; background: none; }
      /* same hover as the Red Dot / reviews links on the front page */
      .freq:not(#jalg) a.freq__name:hover { color: var(--colorBtnPrimary, #3d5640); }
      .freq:not(#jalg) .freq__item-price {
        display: block;
        padding: 0;
        font-size: 15px;
        line-height: 1.35;
        text-align: right;
        white-space: nowrap;
      }
      .freq:not(#jalg) .freq__discount-percentage { margin-left: 4px; }
      .freq__preview { display: none; }
      @media (hover: hover) and (pointer: fine) {
        .freq__preview {
          display: block;
          position: absolute;
          top: 50%;
          right: calc(100% + 16px);
          z-index: 5;
          width: 160px;
          height: 160px;
          padding: 8px;
          background: #fff;
          border: 1px solid #e8e8e1;
          box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
          opacity: 0;
          visibility: hidden;
          transform: translate(6px, -50%);
          transition: opacity .15s ease, transform .15s ease, visibility 0s linear .15s;
          pointer-events: none;
        }
        .freq__preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
        .freq__item:hover .freq__preview {
          opacity: 1;
          visibility: visible;
          transform: translate(0, -50%);
          transition: opacity .15s ease, transform .15s ease;
        }
      }
      @media only screen and (max-width: 589px) {
        .freq:not(#jalg):not(.freq--open) .freq__item--more-m { display: none; }
        .freq:not(#jalg) .freq__more.freq__more--none-m { display: none; }
        .freq__more-d { display: none; }
        .freq:not(.freq--open) .freq__more-m { display: inline; }
        .freq:not(#jalg) .freq__item {
          grid-template-columns: 18px 36px minmax(0, 1fr) auto;
          column-gap: 10px;
          padding: 5px 0;
        }
        .freq:not(#jalg) .freq__thumb {
          display: block;
          width: 36px;
          height: 36px;
          background: #fff;
        }
        .freq:not(#jalg) .freq__thumb img { display: block; width: 100%; height: 100%; object-fit: contain; }
        .freq:not(#jalg) .freq__name,
        .freq:not(#jalg) .freq__item-price { font-size: 14px; line-height: 1.3; }
        .freq:not(#jalg) .freq__discount-percentage { display: block; margin: 0; font-size: 12px; }
        .freq--no-thumbs:not(#jalg) .freq__item { grid-template-columns: 18px minmax(0, 1fr) auto; }
        .freq--no-thumbs:not(#jalg) .freq__thumb { display: none; }
      }
    </style>
    <div class="freq{% unless freq_thumbs %} freq--no-thumbs{% endunless %}" style="padding-top: {{ freq_space_top }}px; padding-bottom: {{ freq_space_bottom }}px;">
        <div class="freq__title">
            {{ title | default: 'Frequently bought together' | escape }}
        </div>
        <div class="freq__list">
            <div class="freq__item">
                <input type="checkbox"
                       class="freq__check"
                       id="freqProd--{{ product.id }}"
                       checked
                       data-price="{{ current_variant.price }}"
                        {% if current_variant.compare_at_price > current_variant.price %}
                            data-price-compare="{{ current_variant.compare_at_price }}"
                        {% else %}
                            data-price-compare="{{ current_variant.price }}"
                        {% endif %}
                       data-id="{{ current_variant.id }}">
                {%- if main_image -%}
                  <span class="freq__thumb" aria-hidden="true">
                    <img src="{{ main_image | image_url: width: 120 }}" alt="" width="40" height="40" loading="lazy" data-freq-thumb>
                  </span>
                {%- endif -%}
                <label class="freq__name" for="freqProd--{{ product.id }}">
                    <span style="font-weight: 600">This item:</span> {{ product.title }}
                </label>
                <span class="freq__item-price">{{ current_variant.price | money }}</span>
                {%- if main_image -%}
                  <span class="freq__preview" aria-hidden="true">
                    <img src="{{ main_image | image_url: width: 320 }}" alt="" width="160" height="160" loading="lazy" data-freq-preview>
                  </span>
                {%- endif -%}
            </div>
            {%- assign freq_shown = 0 -%}
            {% for prod in product.metafields.custom.extra_products.value %}
                {%- assign prod_variant = prod.selected_or_first_available_variant -%}
                {%- assign prod_image = prod_variant.featured_image | default: prod.featured_image -%}
                {% if prod_variant.available %}
                    {%- assign freq_shown = freq_shown | plus: 1 -%}
                    <div class="freq__item{% if freq_shown > freq_limit %} freq__item--more-d{% endif %}{% if freq_shown > freq_limit_m %} freq__item--more-m{% endif %}">
                        <input type="checkbox"
                               class="freq__check"
                               id="freqProd--{{ prod.id }}"
                               aria-label="{{ prod.title | escape }}"
                               data-price="{{ prod_variant.price }}"
                               {% if prod_variant.compare_at_price > prod_variant.price %}
                                   data-price-compare="{{ prod_variant.compare_at_price }}"
                               {% else %}
                                   data-price-compare="{{ prod_variant.price }}"
                               {% endif %}
                               data-id="{{ prod_variant.id }}">
                        {%- if prod_image -%}
                          <span class="freq__thumb" aria-hidden="true">
                            <img src="{{ prod_image | image_url: width: 120 }}" alt="" width="40" height="40" loading="lazy">
                          </span>
                        {%- endif -%}
                        <a class="freq__name" href="{{ prod.url }}" target="_blank">{{ prod.title }}</a>
                        <span class="freq__item-price">
                            {{- prod_variant.price | money -}}
                            {%- if prod_variant.compare_at_price > prod_variant.price -%}
                              {%- assign discount_percentage = prod_variant.compare_at_price | minus: prod_variant.price | times: 100.0 | divided_by: prod_variant.compare_at_price | round -%}
                              <span class="freq__discount-percentage">-{{ discount_percentage }}%</span>
                            {%- endif -%}
                        </span>
                        {%- if prod_variant.compare_at_price > prod_variant.price -%}
                          <span class="freq__item-price-compare">{{ prod_variant.compare_at_price | money }}</span>
                        {%- endif -%}
                        {%- if prod_image -%}
                          <span class="freq__preview" aria-hidden="true">
                            <img src="{{ prod_image | image_url: width: 320 }}" alt="" width="160" height="160" loading="lazy">
                          </span>
                        {%- endif -%}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
        {%- liquid
          assign freq_hidden_d = freq_shown | minus: freq_limit | at_least: 0
          assign freq_hidden_m = freq_shown | minus: freq_limit_m | at_least: 0
        -%}
        {%- if freq_hidden_d > 0 or freq_hidden_m > 0 -%}
          <button type="button"
            class="freq__more{% if freq_hidden_d == 0 %} freq__more--none-d{% endif %}{% if freq_hidden_m == 0 %} freq__more--none-m{% endif %}"
            aria-expanded="false"
            onclick="var f=this.closest('.freq'),o=f.classList.toggle('freq--open');this.setAttribute('aria-expanded',o);">
            <span class="freq__more-d">Show {{ freq_hidden_d }} more</span>
            <span class="freq__more-m">Show {{ freq_hidden_m }} more</span>
            <span class="freq__more-less">Show fewer</span>
          </button>
        {%- endif -%}

        <div class="freq__total">
            Total price: <span class="freq__total-price" data-freq-total>{{ current_variant.price | money }}</span>
            <span data-freq-total-compare style="text-decoration: line-through">
                {% if current_variant.compare_at_price > current_variant.price %}
                    {{ current_variant.compare_at_price | money }}
                {% endif %}
            </span>
        </div>

        <div class="freq__add btn">
            Add selected items to cart
        </div>
    </div>
{% endif %}
