{%- comment -%}
  "This item" uses the selected variant (not product.price, which is the lowest
  price of all variants). theme.js updates it when another variant is picked.
  Extra products also use the price of the variant that gets added to the cart.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign main_image = current_variant.featured_image | default: product.featured_image -%}
{% if product.metafields.custom.extra_products != blank and current_variant.available %}
    {%- comment -%}
      Hovering an item shows its image in a small popup to the left of the list
      (only on devices with a mouse; phones and tablets have no hover).
    {%- endcomment -%}
    <style>
      .freq__item { position: relative; }
      .freq__preview { display: none; }
      @media (hover: hover) and (pointer: fine) {
        .freq__preview {
          display: block;
          position: absolute;
          /* to the left of the list, level with the hovered line, so it
             never covers the other items */
          top: 50%;
          right: calc(100% + 16px);
          z-index: 5;
          width: 160px;
          height: 160px;
          padding: 8px;
          background: #fff;
          border: 1px solid #e8e8e1;
          box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
          opacity: 0;
          visibility: hidden;
          transform: translate(6px, -50%);
          transition: opacity .15s ease, transform .15s ease, visibility 0s linear .15s;
          pointer-events: none;
        }
        .freq__preview img {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
        .freq__item:hover .freq__preview {
          opacity: 1;
          visibility: visible;
          transform: translate(0, -50%);
          transition: opacity .15s ease, transform .15s ease;
        }
      }
    </style>
    <div class="freq">
        <div class="freq__title">
            Frequently bought together
        </div>
        <div class="freq__list">
            <div class="freq__item">
                <input type="checkbox"
                       class="freq__check"
                       id="freqProd--{{ product.id }}"
                       checked
                       data-price="{{ current_variant.price }}"
                        {% if current_variant.compare_at_price > current_variant.price %}
                            data-price-compare="{{ current_variant.compare_at_price }}"
                        {% else %}
                            data-price-compare="{{ current_variant.price }}"
                        {% endif %}
                       data-id="{{ current_variant.id }}">
                <label for="freqProd--{{ product.id }}">
                    <span style="font-weight: 600">This item:</span> {{ product.title }}
                    <span class="freq__item-price">{{ current_variant.price | money }}</span>
                    {%- if main_image -%}
                      <span class="freq__preview" aria-hidden="true">
                        <img src="{{ main_image | image_url: width: 320 }}" alt="" width="160" height="160" loading="lazy" data-freq-preview>
                      </span>
                    {%- endif -%}
                </label>
            </div>
            {% for prod in product.metafields.custom.extra_products.value %}
                {%- assign prod_variant = prod.selected_or_first_available_variant -%}
                {%- assign prod_image = prod_variant.featured_image | default: prod.featured_image -%}
                {% if prod_variant.available %}
                    <div class="freq__item">
                        <input type="checkbox"
                               class="freq__check"
                               id="freqProd--{{ prod.id }}"
                               data-price="{{ prod_variant.price }}"
                               {% if prod_variant.compare_at_price > prod_variant.price %}
                                   data-price-compare="{{ prod_variant.compare_at_price }}"
                               {% else %}
                                   data-price-compare="{{ prod_variant.price }}"
                               {% endif %}
                               data-id="{{ prod_variant.id }}">
                        <a href="{{ prod.url }}" target="_blank">
                            {{ prod.title }}
                            <span class="freq__item-price">
  {{ prod_variant.price | money }}
  {% if prod_variant.compare_at_price > prod_variant.price %}
    {% assign discount_percentage = prod_variant.compare_at_price | minus: prod_variant.price | times: 100.0 | divided_by: prod_variant.compare_at_price | round %}
    <span class="freq__discount-percentage">-{{ discount_percentage }}%</span>
  {% endif %}
</span>

{% if prod_variant.compare_at_price > prod_variant.price %}
  <span class="freq__item-price-compare">
    {{ prod_variant.compare_at_price | money }}
  </span>
{% endif %}
                            {%- if prod_image -%}
                              <span class="freq__preview" aria-hidden="true">
                                <img src="{{ prod_image | image_url: width: 320 }}" alt="" width="160" height="160" loading="lazy">
                              </span>
                            {%- endif -%}
                        </a>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="freq__total">
            Total price: <span class="freq__total-price" data-freq-total>{{ current_variant.price | money }}</span>
            <span data-freq-total-compare style="text-decoration: line-through">
                {% if current_variant.compare_at_price > current_variant.price %}
                    {{ current_variant.compare_at_price | money }}
                {% endif %}
            </span>
        </div>

        <div class="freq__add btn">
            Add selected items to cart
        </div>
    </div>
{% endif %}