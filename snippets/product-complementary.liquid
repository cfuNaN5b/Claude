{%- liquid
  assign recommend_products = true

  if recommendations.products and recommendations.products_count > 0
    assign related_collection = recommendations
  endif

  if type == 'block'
    assign number_of_products = block.settings.complementary_count
    assign image_style = block.settings.image_style
  else
    assign number_of_products = section.settings.complementary_count
  endif
-%}

{%- if type == 'block' -%}
  {% comment %}
    "Pairs well with" block styled like the "Included with your JALG TV stand"
    callout: light green panel with a green line on the left, green 15px title,
    compact product row and an outlined button that doesn't compete with the
    main Add to cart / Preorder button.
  {% endcomment %}
  <style>
    product-recommendations.jalg-addon[data-intent=complementary] {
      container-type: inline-size;
      padding: 18px 20px;
      background: rgba(61, 86, 64, .05);
      border-left: 2px solid #3d5640;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .product-recommendations__title {
      max-width: none;
      margin: 0 0 14px;
      color: #3d5640;
      font-family: var(--typeBasePrimary), var(--typeBaseFallback);
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.4;
      text-transform: none;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid__item {
      margin-bottom: 14px;
      padding-bottom: 0;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid__item:last-child { margin-bottom: 0; }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__content { margin: 0; }
    /* !important on the layout: section Custom CSS (e.g. on the search page,
       where the Quick Add window opens) stacks product cards into a column */
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link {
      display: flex !important;
      flex-direction: row !important;
      align-items: center;
      gap: 16px;
      height: auto !important;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .grid-product__image-mask,
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .image-wrap {
      flex: 0 0 72px;
      width: 72px;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .grid-product__meta {
      display: grid !important;
      flex: 1 1 auto;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 16px;
      width: auto;
      margin: 0;
      padding: 0;
      text-align: left;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__title {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.4;
      text-transform: none;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__price {
      grid-column: 1;
      grid-row: 2;
      margin: 2px 0 0 !important;
      color: #444;
      font-size: 15px;
    }
    /* the theme's sale badge is wider than the 72px image and covers it */
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__tag { display: none; }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__meta .btn {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: auto;
      min-width: 0;
      margin: 0;
      padding: 10px 20px;
      border: 1px solid #3d5640;
      /* !important: the theme's animated-button style would otherwise fill it */
      background-color: transparent !important;
      color: #3d5640 !important;
      font-size: 16px;
      white-space: nowrap;
    }
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__meta .btn:hover,
    product-recommendations.jalg-addon[data-intent=complementary] .grid-product__meta .btn.is-added {
      background-color: #3d5640 !important;
      color: #fff !important;
    }
    /* Tighter in the Quick Add window */
    .modal--quick-shop product-recommendations.jalg-addon[data-intent=complementary] { padding: 14px 16px; }
    .modal--quick-shop product-recommendations.jalg-addon[data-intent=complementary] .product-recommendations__title { margin-bottom: 10px; }
    .modal--quick-shop product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link { gap: 14px; }
    .modal--quick-shop product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .grid-product__image-mask,
    .modal--quick-shop product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .image-wrap {
      flex-basis: 60px;
      width: 60px;
    }
    /* Narrow block (phones, the Quick Add window): button under the price.
       Based on the block's own width, so it also works in narrow columns. */
    @container (max-width: 340px) {
      product-recommendations.jalg-addon[data-intent=complementary] .grid-product__link .grid-product__meta {
        grid-template-columns: minmax(0, 1fr);
      }
      product-recommendations.jalg-addon[data-intent=complementary] .grid-product__meta .btn {
        grid-column: 1;
        grid-row: 3;
        justify-self: start;
        margin-top: 16px;
      }
    }
  </style>
{%- endif -%}

<product-recommendations
  id="Recommendations-{{ section.id }}"
  {% if type == 'block' %}class="jalg-addon"{% endif %}
  data-section-id="{{ section.id }}"
  data-section-type="product-recommendations"
  data-enable="{{ recommend_products }}"
  data-product-id="{{ product.id }}"
  data-intent="complementary"
  {% if type == 'block' %}data-block-id="{{ block.id}}" {{ block.shopify_attributes }}{% endif %}
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ number_of_products }}&intent=complementary"
  data-limit="{{ number_of_products }}">


  {% if block.settings.product_complementary_heading != blank %}
    <h4 class="product-recommendations__title">{{ block.settings.product_complementary_heading }}</h4>
  {% endif %}

  <div
    class="{% unless block.settings.product_complementary_heading != blank %}product-recommendations--title-missing{% endunless %}"
    data-section-id="{{ product.id }}"
    data-subsection
    data-section-type="collection-template">
    {%- if recommend_products -%}
      <div class="product-recommendations-placeholder">
        {% comment %}
          This content is visually hidden and replaced when recommended products show up
        {% endcomment %}
        <div class="grid grid--uniform visually-invisible" aria-hidden="true">
          {%- render 'product-grid-item', product: product, per_row: number_of_products -%}
        </div>
      </div>
    {%- endif -%}
    {%- if related_collection.products_count > 0 -%}
      <div class="product-recommendations">
        <div class="product-single__related grid grid--uniform" data-aos="overflow__animation" {% if type == 'block' %}data-slideshow data-controls="{{ block.settings.control_type }}" data-per-slide="{{ block.settings.per_slide }}" data-count="{{ related_collection.products_count | at_most: number_of_products }}"{% endif %}>
          {% assign currentStep = 1 %}
          {%- for product in related_collection.products limit: number_of_products -%}
            {% if currentStep == 1 %}
              <div class="product-recommendations__slide">
            {% endif %}

            {%- render 'product-grid-item',
              image_style: image_style,
              product: product,
              per_row: 1,
              type: 'horizontal',
              sizes: '112px',
            -%}

            {% if currentStep == block.settings.per_slide or forloop.last %}
              </div>
              {% assign currentStep = 0 %}
            {% endif %}

            {% assign currentStep = currentStep | plus: 1 %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</product-recommendations>
