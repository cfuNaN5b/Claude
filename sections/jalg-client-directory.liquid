{% comment %}
  JALG — Good places. Good company.
  sections/jalg-client-directory.liquid
  Lists styled to match the Dealers page (pages/dealers): the same grid,
  entry style, colours and hover underline.
  Review names, URLs, and classifications before publishing.
{% endcomment %}

<section id="JalgClientDirectory-{{ section.id }}" class="jalg-directory">
  <header class="jd-intro">
    {% if section.settings.eyebrow != blank %}
      <p class="jd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <div class="jd-intro-grid">
      <div>
        <h1 class="h1 jd-title">{{ section.settings.title | escape | newline_to_br }}</h1>
        {% if section.settings.intro != blank %}
          <p class="jd-intro-copy">{{ section.settings.intro | escape | newline_to_br }}</p>
        {% endif %}
      </div>
      {% if section.settings.side_note != blank %}
        <p class="jd-side-note">{{ section.settings.side_note | escape | newline_to_br }}</p>
      {% endif %}
    </div>
  </header>

  {%- for group in (1..3) -%}
    {%- liquid
      if group == 1
        assign category = 'hospitality'
        assign kicker = section.settings.hospitality_kicker
        assign heading = section.settings.hospitality_title
        assign note = section.settings.hospitality_note
        assign caption = section.settings.hospitality_caption
        assign empty_text = 'Add hospitality entries in the section settings.'
      elsif group == 2
        assign category = 'trade'
        assign kicker = section.settings.trade_kicker
        assign heading = section.settings.trade_title
        assign note = section.settings.trade_note
        assign caption = section.settings.trade_caption
        assign empty_text = 'Add design and trade entries in the section settings.'
      else
        assign category = 'workplace'
        assign kicker = section.settings.workplace_kicker
        assign heading = section.settings.workplace_title
        assign note = section.settings.workplace_note
        assign caption = section.settings.workplace_caption
        assign empty_text = 'Add workplace entries in the section settings. This group is hidden on the store until it has entries.'
      endif

      assign group_size = 0
      for block in section.blocks
        if block.settings.category == category
          assign group_size = group_size | plus: 1
        endif
      endfor
      assign count = 0
    -%}
    {%- if group_size == 0 and request.design_mode != true -%}{%- continue -%}{%- endif -%}
    <div class="jd-group jd-group--{{ category }}">
      <div class="jd-group-heading">
        <div>
          {% if kicker != blank %}<p class="jd-eyebrow">{{ kicker | escape }}</p>{% endif %}
          <h2 class="h2 jd-group-title">{{ heading | escape }}</h2>
        </div>
        {% if note != blank %}<p class="jd-group-note">{{ note | escape }}</p>{% endif %}
      </div>

      <ul class="jd-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.category == category -%}
            {%- assign count = count | plus: 1 -%}
            {%- comment -%} Country in normal case ("UNITED KINGDOM" → "United Kingdom"), like the Dealers page {%- endcomment -%}
            {%- liquid
              assign country = ''
              assign words = block.settings.location | downcase | split: ' '
              for word in words
                assign word_cap = word | capitalize
                assign country = country | append: ' ' | append: word_cap
              endfor
              assign country = country | strip
              if category == 'trade' and block.settings.trade_type != blank
                assign meta = block.settings.trade_type
                if country != blank
                  assign meta = meta | append: ' · ' | append: country
                endif
              elsif block.settings.detail != blank and country != blank
                assign meta = block.settings.detail | append: ', ' | append: country
              else
                assign meta = block.settings.detail | default: country
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.url != blank -%}
                <a class="jd-link jd-line" href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer"
                  aria-label="{{ block.settings.name | escape }} – {{ section.settings.visit_label | escape }}">
              {%- else -%}
                <div class="jd-link jd-line">
              {%- endif -%}
                <span class="jd-text">
                  <span class="jd-name">{{ block.settings.name | escape }}</span>
                  {% if meta != blank %}<span class="jd-location">{{ meta | escape }}</span>{% endif %}
                </span>
                {%- if block.settings.url != blank -%}
                  <svg class="jd-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M3 13 13 3M3 3h10v10"/></svg>
                {%- endif -%}
              {%- if block.settings.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {% if count == 0 and request.design_mode %}
        <p class="jd-caption">{{ empty_text }}</p>
      {% endif %}
      {% if caption != blank and count > 0 %}
        <p class="jd-caption">{{ caption | escape }}</p>
      {% endif %}
    </div>
  {%- endfor -%}

  {% if section.settings.cta_text != blank %}
    <div class="jd-cta-band">
      <div class="jd-cta">
        <p class="jd-cta-title">{{ section.settings.cta_text | escape }}</p>
        <div class="jd-cta-actions">
          {% if section.settings.cta_label != blank %}
            <a class="btn jd-cta-button" href="{{ section.settings.cta_url | default: '/pages/contact' }}">{{ section.settings.cta_label | escape }}</a>
          {% endif %}
          {% if section.settings.cta2_label != blank and section.settings.cta2_url != blank %}
            <a class="jd-cta-link jd-line" href="{{ section.settings.cta2_url }}">
              {{ section.settings.cta2_label | escape }}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M3 13 13 3M3 3h10v10"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<style>
  #JalgClientDirectory-{{ section.id }} {
    --green: {{ section.settings.accent_color }};
    --line: {{ section.settings.rule_color }};
    --paper: {{ section.settings.background }};
    display: block;
    padding-bottom: 40px;
    background: var(--paper);
    color: {{ section.settings.text_color }};
  }
  #JalgClientDirectory-{{ section.id }}, #JalgClientDirectory-{{ section.id }} * { box-sizing: border-box; }

  /* Intro: heading and introduction on the left, side note on the right */
  #JalgClientDirectory-{{ section.id }} .jd-intro {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) 40px clamp(32px, 4vw, 56px);
  }
  #JalgClientDirectory-{{ section.id }} .jd-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(150px, 260px);
    gap: 40px;
    align-items: start;
  }
  #JalgClientDirectory-{{ section.id }} .jd-title { max-width: 760px; margin: 0 0 20px; }
  #JalgClientDirectory-{{ section.id }} .jd-intro-copy { max-width: 560px; margin: 0; font-size: 18px; line-height: 1.5; }
  #JalgClientDirectory-{{ section.id }} .jd-side-note {
    position: relative;
    margin: 12px 0 0;
    padding-left: 46px;
    color: #444;
    font-size: 12px;
    line-height: 1.9;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #JalgClientDirectory-{{ section.id }} .jd-side-note::before {
    content: "";
    position: absolute;
    top: 11px;
    left: 0;
    width: 30px;
    height: 1px;
    background: var(--green);
  }
  #JalgClientDirectory-{{ section.id }} .jd-eyebrow {
    margin: 0 0 10px;
    color: var(--green);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* Groups: Hospitality / Design & Trade */
  #JalgClientDirectory-{{ section.id }} .jd-group,
  #JalgClientDirectory-{{ section.id }} .jd-cta {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 40px;
  }
  #JalgClientDirectory-{{ section.id }} .jd-group--trade { background: {{ section.settings.trade_background }}; }
  #JalgClientDirectory-{{ section.id }} .jd-group-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  #JalgClientDirectory-{{ section.id }} .jd-group-title { margin: 0; }
  #JalgClientDirectory-{{ section.id }} .jd-group-note {
    max-width: 320px;
    margin: 0;
    color: #444;
    font-size: 14px;
    line-height: 1.5;
    text-align: right;
  }

  /* List: same grid and entries as the Dealers page */
  #JalgClientDirectory-{{ section.id }} .jd-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 28px;
    margin: 0;
    padding: 24px 0 0;
    list-style: none;
  }
  #JalgClientDirectory-{{ section.id }} .jd-list li { min-width: 0; margin: 0; padding: 0; }
  #JalgClientDirectory-{{ section.id }} .jd-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    min-height: 56px;
    height: 100%;
    padding: 5px 0 12px;
    color: inherit;
  }
  #JalgClientDirectory-{{ section.id }} .jd-text { min-width: 0; }
  #JalgClientDirectory-{{ section.id }} .jd-name {
    display: block;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }
  #JalgClientDirectory-{{ section.id }} .jd-location {
    display: block;
    margin-top: 4px;
    color: #444;
    font-size: 14px;
    line-height: 1.5;
  }
  #JalgClientDirectory-{{ section.id }} .jd-icon { flex: 0 0 auto; margin-top: 5px; color: var(--green); }
  #JalgClientDirectory-{{ section.id }} a.jd-link:is(:hover, :focus-visible) .jd-name { color: var(--green); }
  #JalgClientDirectory-{{ section.id }} .jd-link:focus-visible { outline: 1px solid var(--green); outline-offset: 5px; }

  /* Shared underline (same as the Dealers page) */
  #JalgClientDirectory-{{ section.id }} .jd-line {
    position: relative;
    border: 0;
    border-bottom: 1px solid var(--line) !important;
    text-decoration: none !important;
    background-image: none !important;
    box-shadow: none !important;
  }
  #JalgClientDirectory-{{ section.id }} .jd-line::before { display: none !important; }
  #JalgClientDirectory-{{ section.id }} a.jd-line::after {
    content: "";
    display: block !important;
    position: absolute;
    inset: auto 0 -1px;
    width: 100%;
    height: 1px;
    border: 0 !important;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .35s ease;
    pointer-events: none;
  }
  #JalgClientDirectory-{{ section.id }} a.jd-line:is(:hover, :focus-visible)::after { transform: scaleX(1); }

  #JalgClientDirectory-{{ section.id }} .jd-caption {
    margin: 20px 0 0;
    color: #444;
    font-size: 13px;
    line-height: 1.5;
  }

  /* Closing message: one line with a button to the contact page */
  #JalgClientDirectory-{{ section.id }} .jd-cta-band { border-top: 1px solid var(--line); }
  #JalgClientDirectory-{{ section.id }} .jd-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px 40px;
    padding-top: 32px;
    padding-bottom: 32px;
  }
  #JalgClientDirectory-{{ section.id }} .jd-cta-title {
    margin: 0;
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: calc(var(--typeHeaderSize) * .61);
    line-height: var(--typeHeaderLineHeight);
    letter-spacing: var(--typeHeaderSpacing);
  }
  #JalgClientDirectory-{{ section.id }} .jd-cta-actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  #JalgClientDirectory-{{ section.id }} .jd-cta-button { margin: 0; }
  #JalgClientDirectory-{{ section.id }} .jd-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 4px;
    color: var(--green);
  }

  @media (max-width: 1099px) {
    #JalgClientDirectory-{{ section.id }} .jd-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #JalgClientDirectory-{{ section.id }} .jd-intro,
    #JalgClientDirectory-{{ section.id }} .jd-group,
    #JalgClientDirectory-{{ section.id }} .jd-cta { padding-inline: 24px; }
  }
  @media (max-width: 799px) {
    #JalgClientDirectory-{{ section.id }} .jd-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    #JalgClientDirectory-{{ section.id }} .jd-group-heading { flex-direction: column; align-items: start; gap: 8px; }
    #JalgClientDirectory-{{ section.id }} .jd-group-note { text-align: left; }
    #JalgClientDirectory-{{ section.id }} .jd-cta { flex-direction: column; align-items: start; }
    #JalgClientDirectory-{{ section.id }} .jd-intro-grid { grid-template-columns: 1fr; gap: 20px; }
    #JalgClientDirectory-{{ section.id }} .jd-side-note { margin-top: 0; }
  }
  @media (max-width: 589px) {
    #JalgClientDirectory-{{ section.id }} { padding-bottom: 25px; }
    #JalgClientDirectory-{{ section.id }} .jd-intro { padding-top: 40px; padding-bottom: 24px; }
    #JalgClientDirectory-{{ section.id }} .jd-intro-copy { font-size: 17px; }
    #JalgClientDirectory-{{ section.id }} .jd-group { padding-block: 40px; }
    #JalgClientDirectory-{{ section.id }} .jd-list { grid-template-columns: 1fr; gap: 18px; padding-top: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #JalgClientDirectory-{{ section.id }} a.jd-line::after { transition: none; }
  }
</style>

{% schema %}
{
  "name": "JALG client directory",
  "tag": "section",
  "class": "section-jalg-client-directory",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Intro eyebrow", "default": "JALG · HOSPITALITY, WORKPLACE & DESIGN" },
    { "type": "textarea", "id": "title", "label": "Main heading", "default": "Good places.\nGood company." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "From city hotels and secluded retreats to offices and design studios, JALG finds its place wherever good design is part of the experience. Freestanding and Scandinavian in spirit, it brings a quiet simplicity to spaces where people gather, work and stay." },
    { "type": "textarea", "id": "side_note", "label": "Side note", "default": "Hotels / resorts /\nOffices / studios /\nDesign professionals" },
    { "type": "text", "id": "hospitality_kicker", "label": "Hospitality section label", "default": "01 / HOSPITALITY" },
    { "type": "text", "id": "hospitality_title", "label": "Hospitality heading", "default": "Featured destinations" },
    { "type": "text", "id": "hospitality_note", "label": "Hospitality heading note", "default": "A selection of places around the world" },
    { "type": "text", "id": "hospitality_caption", "label": "Hospitality footnote", "default": "Visit each destination’s website to learn more." },
    { "type": "text", "id": "trade_kicker", "label": "Trade section label", "default": "02 / DESIGN & TRADE" },
    { "type": "text", "id": "trade_title", "label": "Trade heading", "default": "Creative partners" },
    { "type": "text", "id": "trade_note", "label": "Trade heading note", "default": "Design professionals and trade partners" },
    { "type": "text", "id": "trade_caption", "label": "Trade footnote", "default": "Visit each partner’s website to learn more." },
    { "type": "text", "id": "workplace_kicker", "label": "Workplace section label", "default": "03 / WORKPLACE", "info": "The Workplace group only shows on the store once it has entries." },
    { "type": "text", "id": "workplace_title", "label": "Workplace heading", "default": "Spaces for work" },
    { "type": "text", "id": "workplace_note", "label": "Workplace heading note", "default": "Offices, studios and meeting spaces" },
    { "type": "text", "id": "workplace_caption", "label": "Workplace footnote", "default": "Visit each client’s website to learn more." },
    { "type": "textarea", "id": "cta_text", "label": "Closing message", "default": "Planning a hospitality or workplace project?" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave empty to link to the contact page (/pages/contact)." },
    { "type": "text", "id": "cta2_label", "label": "Second link label (optional)", "default": "Trade enquiries" },
    { "type": "url", "id": "cta2_url", "label": "Second link URL", "info": "For example your Trade page. The link only shows when a URL is set." },
    { "type": "text", "id": "visit_label", "label": "Accessible external-link label", "default": "Visit website" },
    { "type": "color", "id": "background", "label": "Main background", "default": "#F6F5F3" },
    { "type": "color", "id": "trade_background", "label": "Trade section background", "default": "#F6F5F3" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#222222" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#3D5640" },
    { "type": "color", "id": "rule_color", "label": "Divider colour", "default": "#D6D6D1" }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client / partner",
