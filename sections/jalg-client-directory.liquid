        { "type": "select", "id": "category", "label": "Section", "options": [
          { "value": "hospitality", "label": "01 / Hospitality" },
          { "value": "trade", "label": "02 / Design & Trade" },
          { "value": "workplace", "label": "03 / Workplace" }
