{%- comment -%}
  3D configurator. Renders the mount point for the React app and the data it
  needs as JSON; the app itself is built from configurator/ into
  assets/configurator.{js,css} and loaded by layout/configurator.liquid.

  Blocks:
  - stand: one of the base products (pick one)
  - accessory: optional add-ons (pick any)
  - color: shared colour choice; its name must match the products' variant
    option value (e.g. "Oat"), so every part is bought in the same colour
{%- endcomment -%}
<div id="configurator-root"></div>

{%- liquid
  assign stand_sep = ''
  assign accessory_sep = ''
  assign color_sep = ''
-%}
<script type="application/json" id="configurator-data">
  {
    "locale": {{ request.locale.iso_code | json }},
    "currency": {{ cart.currency.iso_code | json }},
    "colorOption": {{ section.settings.color_option | json }},
    "tintMaterial": {{ section.settings.tint_material | json }},
    "cartUrl": {{ routes.cart_url | json }},
    "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
    "strings": {
      "heading": {{ section.settings.heading | json }},
      "stands": {{ section.settings.stands_label | json }},
      "color": {{ section.settings.color_label | json }},
      "accessories": {{ section.settings.accessories_label | json }},
      "total": {{ section.settings.total_label | json }},
      "addToCart": {{ section.settings.add_to_cart_label | json }},
      "soldOut": {{ section.settings.sold_out_label | json }},
      "share": {{ section.settings.share_label | json }},
      "copied": {{ section.settings.copied_label | json }}
    },
    "colors": [
      {%- for block in section.blocks -%}
        {%- if block.type == 'color' -%}
          {{ color_sep }}{ "name": {{ block.settings.name | json }}, "swatch": {{ block.settings.swatch | json }} }
          {%- assign color_sep = ',' -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    "stands": [
      {%- for block in section.blocks -%}
        {%- if block.type == 'stand' -%}
          {{ stand_sep }}{%- render 'configurator-part', block: block -%}
          {%- assign stand_sep = ',' -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    "accessories": [
      {%- for block in section.blocks -%}
        {%- if block.type == 'accessory' -%}
          {{ accessory_sep }}{%- render 'configurator-part', block: block -%}
          {%- assign accessory_sep = ',' -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "3D configurator",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your stand" },
    {
      "type": "text",
      "id": "color_option",
      "label": "Colour option name",
      "default": "Color",
      "info": "The variant option that holds the colour. Colour block names must match its values."
    },
    {
      "type": "text",
      "id": "tint_material",
      "label": "Tinted material name",
      "default": "Body",
      "info": "Meshes in the 3D models with this material name take the selected colour."
    },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "stands_label", "label": "Stands", "default": "Stand" },
    { "type": "text", "id": "color_label", "label": "Colour", "default": "Colour" },
    { "type": "text", "id": "accessories_label", "label": "Accessories", "default": "Accessories" },
    { "type": "text", "id": "total_label", "label": "Total", "default": "Total" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "share_label", "label": "Share", "default": "Copy link to this setup" },
    { "type": "text", "id": "copied_label", "label": "Share confirmation", "default": "Link copied" }
  ],
  "blocks": [
    {
      "type": "stand",
      "name": "Stand",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the product title." },
        {
          "type": "text",
          "id": "model",
          "label": "3D model asset",
          "info": "File name of a GLB in the theme's assets, e.g. stand-regular.glb. Leave empty to use the product's 3D model media."
        },
        {
          "type": "range",
          "id": "height",
          "label": "Placeholder height",
          "info": "Used only while the stand has no 3D model.",
          "min": 60,
          "max": 180,
          "step": 5,
          "unit": "cm",
          "default": 100
        }
      ]
    },
    {
      "type": "accessory",
      "name": "Accessory",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the product title." },
        {
          "type": "text",
          "id": "model",
          "label": "3D model asset",
          "info": "File name of a GLB in the theme's assets. Export it in the same position as on the stand."
        },
        {
          "type": "select",
          "id": "kind",
          "label": "Placeholder shape",
          "info": "Used only while the accessory has no 3D model. Wheels also lift the stand.",
          "options": [
            { "value": "shelf", "label": "Shelf" },
            { "value": "wheels", "label": "Wheels" }
          ],
          "default": "shelf"
        }
      ]
    },
    {
      "type": "color",
      "name": "Colour",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "info": "Must match the variant option value exactly." },
        { "type": "color", "id": "swatch", "label": "Swatch", "default": "#d9cfbf" }
      ]
    }
  ]
}
{% endschema %}
