{% comment %}
  JALG Frequently bought together – add to a product template
  (Customize → Product → Add section → "JALG frequently bought together").
  Shows the products from the product's "extra_products" metafield; nothing
  shows when a product has none. The list itself is snippets/frequently-buy.liquid.
{% endcomment %}

{%- if product -%}
<div id="JalgFbt-{{ section.id }}" class="jalg-fbt">
  <div class="page-width">
    <div class="jalg-fbt__inner">
      {%- render 'frequently-buy', product: product, title: section.settings.title -%}
    </div>
  </div>
</div>

<style>
  #JalgFbt-{{ section.id }} .jalg-fbt__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 {% if section.settings.align == 'center' %}auto{% else %}auto 0 0{% endif %};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #JalgFbt-{{ section.id }} .jalg-fbt__inner:not(:has(.freq)) { display: none; }
  #JalgFbt-{{ section.id }} .freq__title { margin-top: 0; }
</style>
{%- endif -%}

{% schema %}
{
  "name": "JALG frequently bought together",
  "class": "section-jalg-fbt",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Frequently bought together" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 360, "max": 1200, "step": 20, "unit": "px", "default": 640 },
    { "type": "select", "id": "align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "paragraph", "content": "The products come from each product's \"Extra products\" metafield (custom.extra_products)." }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "JALG frequently bought together" }]
}
{% endschema %}
